{
  "name": "moneyprinterturbo-mcp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm dev:infra && pnpm dev:local",
    "dev:infra": "docker compose up -d --build --wait mpt-api",
    "dev:infra:down": "docker compose stop mpt-api mpt-webui",
    "dev:local": "tsx watch src/index.ts",
    "dev:docker": "docker compose up --build",
    "dev:docker:down": "docker compose down",
    "webui": "docker compose --profile webui up -d mpt-webui",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "hono": "^4.12.17",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.5"
  }
}

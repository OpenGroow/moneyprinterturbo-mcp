# Port this MCP/API server listens on.
PORT=4600

# Base URL of the already-running, separately-deployed MoneyPrinterTurbo
# instance. From inside the OpenClaw docker container this is typically
# http://host.docker.internal:8080 -- see MoneyPrinterTurbo's own
# config.example.toml (listen_port = 8080).
MPT_BASE_URL=http://localhost:8080

# MoneyPrinterTurbo's own `x-api-key` auth (app/controllers/base.py
# verify_token). MPT only enforces this when ITS OWN config.toml sets
# `api_key` -- if that's empty on the MPT side, MPT accepts any value here,
# including a dummy one. Never sent as an Authorization/Bearer header.
MPT_API_KEY=
# MoneyPrinterTurbo image started by docker compose (required, no default in the compose file).
# The `comfyui` video provider does not exist in the official image: it needs a fork.
MPT_IMAGE=ghcr.io/harry0703/moneyprinterturbo:latest

# true: produce_video logs its parameters and answers without calling MPT (no credits spent)
MPT_DRY_RUN=false

# Optional: caps video_terms to N terms (MPT generates one ComfyUI clip per term). 1 = a single clip, for quick tests.
# No effect if the caller does not pass video_terms (MPT then picks its own terms).
# MPT_MAX_CLIPS=1

# Optional: values produce_video applies when the caller leaves them out.
# Useful to pin a video source or a voice your MPT has credentials for (the `comfyui` provider needs a fork).
# MPT_DEFAULT_VIDEO_SOURCE=
# MPT_DEFAULT_VOICE_NAME=

# Public origin of this server (publicly reachable, for example a tunnel
# in local dev). get_video returns <PUBLIC_BASE_URL>/videos/<runId>/final.
PUBLIC_BASE_URL=http://localhost:4600

# Bearer key that protects /mcp (the same value goes in the OpenGroow Template's apiKey).
MCP_API_KEY=

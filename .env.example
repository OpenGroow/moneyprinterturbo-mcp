# Port this MCP/API server listens on.
PORT=4600

# Base URL of the already-running, separately-deployed MoneyPrinterTurbo
# instance. From inside the OpenClaw docker container this is typically
# http://host.docker.internal:8080 -- see MoneyPrinterTurbo's own
# config.example.toml (listen_port = 8080).
MPT_BASE_URL=http://localhost:8080

# MoneyPrinterTurbo's own `x-api-key` auth (app/controllers/base.py
# verify_token). MPT only enforces this when ITS OWN config.toml sets
# `api_key` -- if that's empty on the MPT side, MPT accepts any value here,
# including a dummy one. Never sent as an Authorization/Bearer header.
MPT_API_KEY=
# Image MoneyPrinterTurbo lancée par docker compose (obligatoire, pas de défaut dans le compose).
# Le provider vidéo `comfyui` n'existe pas dans l'officielle : il demande un fork.
MPT_IMAGE=ghcr.io/harry0703/moneyprinterturbo:latest

# true : produce_video logue ses paramètres et répond sans appeler MPT (aucun crédit dépensé)
MPT_DRY_RUN=false

# Optionnel : plafonne video_terms à N termes (MPT génère 1 clip ComfyUI par terme). 1 = un seul clip, pour tester vite.
# Sans effet si l'appelant ne fournit pas video_terms (MPT choisit alors ses propres termes).
# MPT_MAX_CLIPS=1

# Public origin of this server (publicly reachable, for example a tunnel
# in local dev). get_video returns <PUBLIC_BASE_URL>/videos/<runId>/final.
# Optional: without it get_video answers a not_configured error.
PUBLIC_BASE_URL=

# One bearer key per brand in src/projects.ts's PROJECTS registry
# (MCP_API_KEY_<NAME>, name uppercased). This key authenticates /mcp for
# that brand. Add a brand to projects.ts, then its matching key here.
MCP_API_KEY_LOVEYOUMAKE=
MCP_API_KEY_REZON=
